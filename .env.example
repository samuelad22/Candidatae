# ====== Configuración local de Candidatae ======
# Copia este fichero como ".env" y rellena los valores que necesites.
# El fichero ".env" NUNCA se sube al repositorio (está en el .gitignore).
#
# Todas las variables tienen un valor por defecto en application.properties,
# así que la aplicación arranca sin este fichero. Solo es obligatorio en producción.

# ====== Base de datos (PostgreSQL) ======
DB_URL=jdbc:postgresql://localhost:5432/candidatae
DB_USERNAME=admin
DB_PASSWORD=admin

# ====== Autenticación (JWT) ======
# Clave de firma de los tokens. En producción: al menos 32 caracteres aleatorios.
# Genera una con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ====== Frontend ======
# Orígenes permitidos por CORS (separados por comas).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# A dónde redirige el callback de OAuth2 de Google.
FRONTEND_BASE_URL=http://localhost:5173

# ====== Logs de SQL (Hibernate) ======
# "false" en producción: el SQL a consola ensucia el log y puede filtrar datos.
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# ====== Cifrado de los tokens de Gmail (AES-256-GCM) ======
# Clave de 32 bytes en Base64. Genera una con: openssl rand -base64 32
# ⚠️ Si cambias esta clave, los refresh tokens ya guardados dejarán de descifrarse.
GMAIL_TOKEN_ENCRYPTION_KEY=

# ====== OAuth2 de Google (vinculación de buzones Gmail, solo lectura) ======
# Google Cloud Console > Credentials > OAuth Client ID (tipo "Web application").
# La redirect URI debe coincidir EXACTAMENTE con la de abajo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/email-accounts/gmail/callback
# "true" en producción (requiere que la app se sirva por HTTPS).
GMAIL_SECURE_COOKIE=false
# Validez (en segundos) del "state" anti-CSRF de la vinculación.
GMAIL_STATE_TTL_SECONDS=600
